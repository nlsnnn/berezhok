diff --git a/traefik/dynamic.yml b/traefik/dynamic.yml
index 007e306..9f6d5e9 100644
--- a/traefik/dynamic.yml
+++ b/traefik/dynamic.yml
@@ -1,4 +1,65 @@
 http:
+  routers:
+    api:
+      rule: "Host(`fooday.live`) && PathPrefix(`/api/`)"
+      entryPoints:
+        - websecure
+      tls:
+        certResolver: letsencrypt
+      service: api-service
+      priority: 20
+      middlewares:
+        - api-ratelimit
+        - secure-headers
+
+    frontend:
+      rule: "Host(`fooday.live`)"
+      entryPoints:
+        - websecure
+      tls:
+        certResolver: letsencrypt
+      service: frontend-service
+      priority: 1
+
+    chat-api:
+      rule: "Host(`fooday.live`) && PathPrefix(`/chat-api/`)"
+      entryPoints:
+        - websecure
+      tls:
+        certResolver: letsencrypt
+      service: chat-service
+      priority: 30
+      middlewares:
+        - chat-api-rewrite
+        - api-ratelimit
+
+    chat-ws:
+      rule: "Host(`fooday.live`) && PathPrefix(`/chat-ws`)"
+      entryPoints:
+        - websecure
+      tls:
+        certResolver: letsencrypt
+      service: chat-service
+      priority: 25
+      middlewares:
+        - chat-ws-rewrite
+
+  services:
+    api-service:
+      loadBalancer:
+        servers:
+          - url: "http://berezhok-api:8080"
+
+    frontend-service:
+      loadBalancer:
+        servers:
+          - url: "http://berezhok-frontend:80"
+
+    chat-service:
+      loadBalancer:
+        servers:
+          - url: "http://berezhok-chat:8090"
+
   middlewares:
     api-ratelimit:
       rateLimit:
diff --git a/traefik/traefik.yml b/traefik/traefik.yml
index e0b372c..b86319f 100644
--- a/traefik/traefik.yml
+++ b/traefik/traefik.yml
@@ -5,6 +5,25 @@ api:
 entryPoints:
   web:
     address: ":80"
+    http:
+      redirections:
+        entryPoint:
+          to: websecure
+          scheme: https
+          permanent: true
+  websecure:
+    address: ":443"
+    http:
+      tls:
+        certResolver: letsencrypt
+
+certificatesResolvers:
+  letsencrypt:
+    acme:
+      email: admin@fooday.live
+      storage: /etc/traefik/acme.json
+      httpChallenge:
+        entryPoint: web

 providers:
   docker:
